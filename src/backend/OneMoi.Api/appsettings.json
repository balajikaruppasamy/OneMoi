{
  "//": "Shared settings — this file IS stored in GitHub, so it must NEVER contain passwords or keys. Secrets come from appsettings.Development.json (your PC, not in Git) or from environment variables on Render (e.g. ConnectionStrings__OneMoi, Jwt__Key).",
  "ConnectionStrings": {
    "OneMoi": ""
  },
  "Database": {
    "AutoMigrate": true,
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "OneMoi",
    "Audience": "OneMoi.Web",
    "Key": "",
    "AccessTokenMinutes": 120
  },
  "App": {
    "ExposeOtpInResponse": false,
    "OtpExpiryMinutes": 5,
    "OtpMaxPerHour": 10,
    "OtpSecret": "",
    "RefreshTokenDays": 30,
    "CorrectionWindowMinutes": 10,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "RateLimit": {
    "LoginPerMinute": 30,
    "OtpPerMinute": 10
  },
  "Storage": {
    "Provider": "Local"
  },
  "Supabase": {
    "Url": "",
    "ServiceKey": "",
    "Bucket": "onemoi"
  },
  "Swagger": {
    "Enabled": false
  },
  "Transliteration": {
    "UseGoogle": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "no-reply@onemoi.in"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*"
}
